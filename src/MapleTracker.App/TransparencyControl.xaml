<UserControl x:Class="MapleTracker.App.TransparencyControl" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Grid Margin="0,12,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="40"/></Grid.ColumnDefinitions>
    <TextBlock Text="Transparency" Foreground="{StaticResource Muted}" FontSize="11" VerticalAlignment="Center" Margin="0,0,14,0"/>
    <Slider x:Name="TransparencySlider" Grid.Column="1" Minimum="0" Maximum="60" TickFrequency="5" ValueChanged="ValueChanged" VerticalAlignment="Center" AutomationProperties.Name="Window transparency"/>
    <TextBlock x:Name="PercentText" Grid.Column="2" Foreground="#B4C5E5" TextAlignment="Right" FontSize="11" VerticalAlignment="Center"/>
  </Grid>
</UserControl>
