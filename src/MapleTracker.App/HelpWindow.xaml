<Window x:Class="MapleTracker.App.HelpWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:MapleTracker.App" Style="{StaticResource OverlayWindow}" Title="MapleTracker · Help" Width="800" Height="720" MinWidth="560" MinHeight="400" WindowStartupLocation="CenterOwner">
  <DockPanel>
    <local:OverlayTitleBar DockPanel.Dock="Top"/>
    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="22,6,22,14">
      <Button Content="User guide" Click="GuideClick"/><Button Content="Third-party notices" Click="NoticesClick"/>
    </StackPanel>
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel x:Name="Document" Margin="26,0,26,26"/></ScrollViewer>
  </DockPanel>
</Window>
