<Window x:Class="MapleTracker.App.StatsWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:MapleTracker.App"
        Style="{StaticResource OverlayWindow}" Title="MapleTracker · Statistics" Width="410" Height="760" MinWidth="360" MinHeight="620">
  <DockPanel>
    <local:OverlayTitleBar DockPanel.Dock="Top"/>
    <Border DockPanel.Dock="Bottom" BorderBrush="{StaticResource Hairline}" BorderThickness="0,1,0,0" Padding="22,0,22,18"><local:TransparencyControl x:Name="Transparency"/></Border>
    <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="22,8,22,20">
      <Grid Margin="0,0,0,18"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <StackPanel><TextBlock Text="Make the session count." FontSize="21" FontWeight="SemiBold"/><TextBlock Text="EXP &amp; MESO" Foreground="{StaticResource Muted}" FontSize="10" Margin="0,7,0,0"/></StackPanel>
        <TextBlock x:Name="Mode" Grid.Column="1" Foreground="{StaticResource Accent}" VerticalAlignment="Center" FontSize="10" Margin="12,0,0,0"/>
      </Grid>
      <Grid Margin="0,0,0,18"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
        <Button x:Name="StatsStartButton" Content="Start" Style="{StaticResource PrimaryButton}" Click="StartClick"/>
        <Button x:Name="StatsStopButton" Grid.Column="1" Content="Stop" Click="StopClick"/>
        <Button x:Name="StatsResetButton" Grid.Column="2" Content="Reset" Click="ResetClick" Margin="0"/>
      </Grid>
      <Border Background="{StaticResource Panel}" Padding="18" CornerRadius="10" Margin="0,0,0,12"><StackPanel>
        <TextBlock x:Name="LevelText" Text="Waiting for EXP" FontSize="17" FontWeight="SemiBold"/>
        <TextBlock x:Name="ExperienceText" Text="Mark the level and EXP text in Setup." Foreground="{StaticResource Muted}" Margin="0,8,0,12"/>
        <ProgressBar x:Name="ExperienceProgress" Height="5" Minimum="0" Maximum="100" Foreground="#A8B9FF" Background="#28FFFFFF" BorderThickness="0"/>
        <TextBlock x:Name="RemainingText" Foreground="{StaticResource Muted}" FontSize="11" LineHeight="17" Margin="0,10,0,0"/>
      </StackPanel></Border>
      <Border Background="#196E7FCB" Padding="18" CornerRadius="10" Margin="0,0,0,12"><StackPanel>
        <TextBlock Text="TIME TO NEXT LEVEL" Foreground="#B7C6FF" FontSize="10" FontWeight="SemiBold"/>
        <TextBlock x:Name="EtaText" Text="—" FontSize="29" FontWeight="SemiBold" Margin="0,5,0,0"/>
        <TextBlock Text="At your recent EXP pace" Foreground="{StaticResource Muted}" FontSize="11" Margin="0,4,0,0"/>
      </StackPanel></Border>
      <Grid Margin="0,0,0,15"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
        <Border Background="{StaticResource Panel}" Padding="15" CornerRadius="10"><StackPanel><TextBlock Text="EXP / HOUR" Foreground="#A8B9FF" FontSize="10"/><TextBlock x:Name="XpHour" Text="—" FontSize="25" Margin="0,7,0,4"/><TextBlock x:Name="XpMinute" Foreground="{StaticResource Muted}" FontSize="11"/></StackPanel></Border>
        <Border Grid.Column="2" Background="{StaticResource Panel}" Padding="15" CornerRadius="10"><StackPanel><TextBlock Text="MESO / HOUR" Foreground="#E5C38B" FontSize="10"/><TextBlock x:Name="MesoHour" Text="—" FontSize="25" Margin="0,7,0,4"/><TextBlock x:Name="MesoMinute" Foreground="{StaticResource Muted}" FontSize="11"/></StackPanel></Border>
      </Grid>
      <TextBlock x:Name="TotalsText" Foreground="#D6E0F2" LineHeight="25"/>
      <TextBlock x:Name="ActiveText" Foreground="{StaticResource Muted}" Margin="0,6,0,14"/>
      <TextBlock Text="Stop preserves totals. Start resumes from your current EXP. Reset clears these statistics; chat and alerts keep running." Foreground="#8B9BB5" FontSize="11" LineHeight="18"/>
      <Expander Header="Recognition details" Foreground="{StaticResource Muted}" Margin="0,16,0,0"><TextBox x:Name="Diagnostics" IsReadOnly="True" TextWrapping="Wrap" MaxHeight="180" VerticalScrollBarVisibility="Auto" FontSize="11" Margin="0,8,0,0"/></Expander>
    </StackPanel></ScrollViewer>
  </DockPanel>
</Window>
