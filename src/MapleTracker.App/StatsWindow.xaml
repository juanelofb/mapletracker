<Window x:Class="MapleTracker.App.StatsWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Style="{StaticResource TrackerWindow}" Title="MapleTracker · Statistics" Width="390" Height="650" MinWidth="350" MinHeight="590">
  <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="22">
    <TextBlock Text="SESSION TRACKER" Foreground="{StaticResource Muted}" FontSize="11" FontWeight="SemiBold"/>
    <Grid Margin="0,12,0,20"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="The next level" FontSize="25" FontWeight="SemiBold"/><TextBlock x:Name="Mode" Grid.Column="1" Foreground="{StaticResource Accent}" VerticalAlignment="Center" FontSize="11"/></Grid>
    <Border Background="{StaticResource Panel}" Padding="18" CornerRadius="8" Margin="0,0,0,12"><StackPanel><TextBlock x:Name="LevelText" Text="Waiting for EXP" FontSize="17" FontWeight="SemiBold"/><TextBlock x:Name="ExperienceText" Text="Mark the level and EXP text in Setup." Foreground="{StaticResource Muted}" Margin="0,8,0,10"/><ProgressBar x:Name="ExperienceProgress" Height="6" Minimum="0" Maximum="100" Foreground="#C7D66A" Background="#2A3646" BorderThickness="0"/><TextBlock x:Name="RemainingText" Foreground="{StaticResource Muted}" FontSize="11" Margin="0,9,0,0"/></StackPanel></Border>
    <Border Background="#252A29" Padding="18" CornerRadius="8" Margin="0,0,0,12"><StackPanel><TextBlock Text="ESTIMATED TIME TO LEVEL" Foreground="#CFBA95" FontSize="10" FontWeight="SemiBold"/><TextBlock x:Name="EtaText" Text="—" FontSize="30" FontWeight="SemiBold" Margin="0,5,0,0"/><TextBlock Text="Based on your last 5 minutes of active capture" Foreground="{StaticResource Muted}" FontSize="11" Margin="0,4,0,0"/></StackPanel></Border>
    <Grid Margin="0,0,0,12"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Border Background="{StaticResource Panel}" Padding="15" CornerRadius="7"><StackPanel><TextBlock Text="EXP / HOUR" Foreground="#C7D66A" FontSize="10"/><TextBlock x:Name="XpHour" Text="—" FontSize="23" Margin="0,7,0,4"/><TextBlock x:Name="XpMinute" Foreground="{StaticResource Muted}" FontSize="11"/></StackPanel></Border><Border Grid.Column="2" Background="{StaticResource Panel}" Padding="15" CornerRadius="7"><StackPanel><TextBlock Text="MESO / HOUR" Foreground="#E1BC70" FontSize="10"/><TextBlock x:Name="MesoHour" Text="—" FontSize="23" Margin="0,7,0,4"/><TextBlock x:Name="MesoMinute" Foreground="{StaticResource Muted}" FontSize="11"/></StackPanel></Border></Grid>
    <TextBlock x:Name="TotalsText" Foreground="#D6E0ED" LineHeight="24"/><TextBlock x:Name="ActiveText" Foreground="{StaticResource Muted}" Margin="0,5,0,14"/>
    <TextBlock Text="Meso counts visible pickup notifications. EXP is net progress from the HUD, including losses. Pausing preserves your session." Foreground="#7589A0" FontSize="11" LineHeight="17"/>
    <Expander Header="Recognition details" Foreground="{StaticResource Muted}" Margin="0,16,0,0"><TextBox x:Name="Diagnostics" IsReadOnly="True" TextWrapping="Wrap" MaxHeight="180" VerticalScrollBarVisibility="Auto" FontSize="11" Margin="0,8,0,0"/></Expander>
  </StackPanel></ScrollViewer>
</Window>
