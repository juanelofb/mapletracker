<Window x:Class="MapleTracker.App.SetupWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Style="{StaticResource TrackerWindow}" Title="MapleTracker · Setup" Width="1020" Height="790" MinWidth="760" MinHeight="650" WindowStartupLocation="CenterOwner">
  <Grid Margin="22"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <StackPanel><TextBlock Text="Tell MapleTracker where to look" FontSize="24" FontWeight="SemiBold"/><TextBlock Text="Use windowed or borderless mode. Keep the text visible and place tracker windows beside the game." Foreground="{StaticResource Muted}" Margin="0,8,0,16"/></StackPanel>
    <Grid Grid.Row="1" Margin="0,0,0,14"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
      <ComboBox x:Name="WindowPicker" DisplayMemberPath="Title" Foreground="Black" VerticalContentAlignment="Center" Margin="0,0,10,0" AutomationProperties.Name="Game window"/>
      <Button Grid.Column="1" Content="Refresh" Click="RefreshClick"/><Button x:Name="SnapshotButton" Grid.Column="2" Content="Take snapshot" Click="SnapshotClick"/><Button Grid.Column="3" Content="Load image" Click="LoadClick" Margin="0"/>
    </Grid>
    <Grid Grid.Row="2"><Grid.ColumnDefinitions><ColumnDefinition Width="175"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
      <StackPanel Margin="0,0,14,0"><TextBlock Text="SELECT A REGION" Foreground="{StaticResource Muted}" FontSize="10" Margin="0,0,0,10"/>
        <RadioButton x:Name="ChatRadio" Content="1   Chat messages" GroupName="Region" IsChecked="True" Foreground="#75C6E2" Margin="0,8" Checked="RegionChanged"/>
        <RadioButton x:Name="LootRadio" Content="2   Loot notifications" GroupName="Region" Foreground="#E1BC70" Margin="0,8" Checked="RegionChanged"/>
        <RadioButton x:Name="LevelRadio" Content="3   Level number" GroupName="Region" Foreground="#F07961" Margin="0,8" Checked="RegionChanged"/>
        <RadioButton x:Name="ExpRadio" Content="4   EXP number + %" GroupName="Region" Foreground="#C7D66A" Margin="0,8" Checked="RegionChanged"/>
        <TextBlock x:Name="RegionInfo" Foreground="{StaticResource Muted}" FontSize="11" LineHeight="18" Margin="0,18,0,0"/>
        <Button Content="Test recognition" Click="TestClick" Margin="0,18,0,0"/>
        <TextBlock Text="Draw a tight box around the text, with a little padding. Include every chat or loot line you want to keep." Foreground="#7589A0" FontSize="11" LineHeight="17" Margin="0,15,0,0"/>
      </StackPanel>
      <Grid Grid.Column="1" x:Name="Preview" Background="#080D14" ClipToBounds="True" SizeChanged="PreviewSizeChanged">
        <Image x:Name="ReferenceImage" Stretch="Uniform"/>
        <TextBlock x:Name="PreviewHint" Text="Take a game snapshot or load a screenshot.&#10;Then select a region and drag around its text." HorizontalAlignment="Center" VerticalAlignment="Center" TextAlignment="Center" Foreground="{StaticResource Muted}" Margin="20"/>
        <Canvas x:Name="SelectionCanvas" Background="Transparent" MouseLeftButtonDown="SelectionStart" MouseMove="SelectionMove" MouseLeftButtonUp="SelectionEnd"/>
      </Grid>
    </Grid>
    <Grid Grid.Row="3" Margin="0,18,0,14"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="170"/></Grid.ColumnDefinitions>
      <StackPanel Margin="0,0,14,0"><TextBlock Text="BUYING TERMS · comma separated" FontSize="10" Foreground="{StaticResource Muted}" Margin="0,0,0,7"/><TextBox x:Name="BuyingTerms"/></StackPanel>
      <StackPanel Grid.Column="1" Margin="0,0,14,0"><TextBlock Text="SELLING TERMS · comma separated" FontSize="10" Foreground="{StaticResource Muted}" Margin="0,0,0,7"/><TextBox x:Name="SellingTerms"/></StackPanel>
      <StackPanel Grid.Column="2"><TextBlock Text="WINDOW OPACITY" FontSize="10" Foreground="{StaticResource Muted}" Margin="0,0,0,8"/><Slider x:Name="OpacitySlider" Minimum=".4" Maximum="1" Value="1" TickFrequency=".1"/></StackPanel>
    </Grid>
    <Grid Grid.Row="4"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
      <TextBlock x:Name="SetupStatus" Foreground="{StaticResource Muted}" FontSize="11" VerticalAlignment="Center" Margin="0,0,12,0" Text="Default regions match your original screenshot; recalibrate for another layout."/>
      <Button Grid.Column="1" Content="Cancel" IsCancel="True"/><Button x:Name="SaveButton" Grid.Column="2" Content="Save setup" Background="#DF755E" Foreground="#111722" FontWeight="SemiBold" Click="SaveClick" Margin="0"/>
    </Grid>
  </Grid>
</Window>
