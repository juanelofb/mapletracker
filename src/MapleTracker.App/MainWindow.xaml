<Window x:Class="MapleTracker.App.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:MapleTracker.App"
        Style="{StaticResource OverlayWindow}" Title="MapleTracker · Chat" Width="740" Height="680" MinWidth="610" MinHeight="480">
  <DockPanel>
    <local:OverlayTitleBar DockPanel.Dock="Top"/>
    <Grid Margin="22,8,22,20"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
      <WrapPanel Margin="0,0,0,10">
        <WrapPanel.Resources><Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Setter Property="Margin" Value="0,0,7,6"/></Style></WrapPanel.Resources>
        <Button Content="Setup" Click="SetupClick"/><Button x:Name="StartButton" Content="Start capture" Style="{StaticResource PrimaryButton}" Click="StartClick" Margin="0,0,7,6"/>
        <Button x:Name="PauseButton" Content="Pause" Click="PauseClick"/><Button Content="Statistics ↗" Click="StatsClick"/>
        <Button x:Name="AlertsButton" Content="Item alerts" Click="AlertsClick"/>
        <CheckBox x:Name="PopupToggle" Style="{StaticResource Switch}" Content="Popups" Click="PopupChanged" Height="36" Margin="4,0,12,6"/>
        <CheckBox x:Name="TopCheck" Style="{StaticResource Switch}" Content="Keep on top" Click="TopChanged" Height="36" Margin="0,0,0,6"/>
      </WrapPanel>
      <Grid Grid.Row="1" Margin="0,0,0,18"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <Grid>
          <TextBox x:Name="Search" TextChanged="SearchChanged" ToolTip="Search captured messages" AutomationProperties.Name="Search captured messages"/>
          <TextBlock x:Name="SearchPlaceholder" Text="Search messages…" Foreground="{StaticResource Muted}" VerticalAlignment="Center" Margin="12,0" IsHitTestVisible="False">
            <TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers>
              <DataTrigger Binding="{Binding Text, ElementName=Search}" Value=""><Setter Property="Visibility" Value="Visible"/></DataTrigger>
            </Style.Triggers></Style></TextBlock.Style>
          </TextBlock>
        </Grid>
        <CheckBox x:Name="FollowCheck" Content="Follow new" IsChecked="True" Grid.Column="1" Margin="14,0,0,0"/>
      </Grid>
      <TabControl x:Name="Tabs" Grid.Row="2">
        <TabItem Header="All"><Grid><ListBox x:Name="AllList" ItemTemplate="{StaticResource MessageRow}"/>
          <StackPanel x:Name="EmptyState" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="24" IsHitTestVisible="False">
            <TextBlock Text="Your conversation lives here" FontSize="20" FontWeight="SemiBold" TextAlignment="Center"/>
            <TextBlock Text="Choose the game and its text regions in Setup,&#10;then start capture." TextAlignment="Center" Foreground="{StaticResource Muted}" Margin="0,12,0,0" LineHeight="23"/>
          </StackPanel></Grid></TabItem>
        <TabItem Header="Buying"><ListBox x:Name="BuyingList" ItemTemplate="{StaticResource MessageRow}"/></TabItem>
        <TabItem Header="Selling"><ListBox x:Name="SellingList" ItemTemplate="{StaticResource MessageRow}"/></TabItem>
        <TabItem Header="Items"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
          <TextBlock x:Name="LootHeading" Text="No pickups captured yet" Margin="12,12,12,8" FontWeight="SemiBold" Foreground="#E5C38B"/>
          <ScrollViewer Grid.Row="1" MaxHeight="140" VerticalScrollBarVisibility="Auto" Margin="12,0,12,10"><ItemsControl x:Name="LootTotals"><ItemsControl.ItemTemplate><DataTemplate>
            <DockPanel Margin="0,4"><TextBlock Text="{Binding Value, StringFormat=×{0:N0}}" DockPanel.Dock="Right" Foreground="#E5C38B" FontWeight="SemiBold" Margin="20,0,0,0"/><TextBlock Text="{Binding Key}"/></DockPanel>
          </DataTemplate></ItemsControl.ItemTemplate></ItemsControl></ScrollViewer>
          <ListBox Grid.Row="2" x:Name="ItemsList" ItemTemplate="{StaticResource MessageRow}"/>
        </Grid></TabItem>
      </TabControl>
      <StackPanel Grid.Row="3" Margin="0,14,0,0"><TextBlock x:Name="StatusText" Foreground="{StaticResource Muted}" FontSize="11"/><local:TransparencyControl x:Name="Transparency"/></StackPanel>
    </Grid>
  </DockPanel>
</Window>
